<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Neoluma.Compiler\Neoluma.Compiler.csproj" />
    <ProjectReference Include="../Neoluma.Frontend.Probe/Neoluma.Frontend.Probe.csproj" ReferenceOutputAssembly="false" />
    <Content Include="Frontend/Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../TestProject/**/*" Link="FrontendTestProject/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyFrontendProbe" AfterTargets="Build">
    <ItemGroup>
      <FrontendProbeFiles Include="$(MSBuildProjectDirectory)/../Neoluma.Frontend.Probe/bin/$(Configuration)/net10.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendProbeFiles)" DestinationFiles="@(FrontendProbeFiles->'$(OutDir)frontend-probe/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
